  "kpis": [
    {
      "id": "staff_coverage",
      "label": "Staff Coverage",
      "metric": "coverage_pct",
      "format": "percent",
      "good": "high",
      "hint": "Shifts with a qualified nurse assigned"
    },
    {
      "id": "critical",
      "label": "Critical Shortages",
      "metric": "critical_uncovered",
      "format": "count",
      "good": "low",
      "hint": "Uncovered ICU/critical shifts"
    },
    {
      "id": "skills",
      "label": "Skill Coverage",
      "metric": "skill_coverage_pct",
      "format": "percent",
      "good": "high",
      "hint": "Shifts staffed with all required certifications"
    },
    {
      "id": "overtime",
      "label": "Overtime",
      "metric": "overtime_hours",
      "format": "hours",
      "good": "low",
      "hint": "Hours above contracted this week"
