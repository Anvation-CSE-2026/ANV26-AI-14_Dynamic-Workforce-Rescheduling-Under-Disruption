# Copy to backend/.env (or export in your shell). Secrets stay on the server; the browser never sees them.

# Storage: SQLite file by default; Supabase/Postgres e.g. postgresql+psycopg://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite:///./resqwork.db

# Auth
#   demo     → unauthenticated requests act as a demo manager (hackathon demo)
#   required → every request needs a Bearer token (production)
RESQWORK_AUTH_MODE=demo
RESQWORK_SECRET=                      # empty = run.py creates and keeps one in .resqwork_secret
GOOGLE_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# AI layer (optional: without a key, rule-based parsers and template explanations are used)
RESQWORK_LLM_PROVIDER=                # claude | openai | gemini | none (empty = claude if ANTHROPIC_API_KEY is set, else none)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
RESQWORK_EMBEDDER=hashing             # hashing (default, offline) | voyage
VOYAGE_API_KEY=

# Voice assistant: Gemini transcribes and interprets spoken commands (uses GEMINI_API_KEY above).
# Without a key the UI falls back to browser speech recognition (Chrome/Edge) or typing.
RESQWORK_GEMINI_VOICE_MODEL=gemini-3.8-flash

# Demo logins (manager/admin/employees per industry, password demo1234). Default: on when RESQWORK_AUTH_MODE=demo
RESQWORK_DEMO_ACCOUNTS=on

# Optional server text-to-speech (otherwise the browser speaks)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

LOG_LEVEL=INFO
# Notifications (optional; without these, email/SMS/WhatsApp are simulated and logged to the outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# Local experiments only: allow unauthenticated requests to act as a demo admin
RESQWORK_ANONYMOUS_DEMO=off
